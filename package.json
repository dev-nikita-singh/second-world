{
  "name": "second-world",
  "version": "0.1.0",
  "description": "Intelligent software experimentation, testing and optimization engine",
  "type": "module",
  "license": "MIT",
  "author": "The SECOND WORLD contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-nikita-singh/second-world.git"
  },
  "homepage": "https://github.com/dev-nikita-singh/second-world#readme",
  "bugs": {
    "url": "https://github.com/dev-nikita-singh/second-world/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "sw": "./dist/cli.mjs",
    "second-world": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && tsx src/ui/web/build.ts dist/ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check src tests examples",
    "format": "biome format --write src tests examples",
    "sw": "tsx src/cli/main.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@clack/prompts": "^1.8.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c12": "^3.3.4",
    "ci-info": "^4.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "execa": "^10.2.1",
    "fast-check": "^4.10.2",
    "hdr-histogram-js": "^3.0.1",
    "ignore": "^7.0.14",
    "log-update": "^8.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "semver": "^7.8.5",
    "tinyglobby": "^0.2.17",
    "ulid": "^3.0.2",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=5.0 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "get-port": "^7.2.0",
    "preact": "^10.29.8",
    "tsdown": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
